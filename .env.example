# Supabase（必填）
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 站点地址（用于邮箱验证回跳）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI 解读（必填，服务端专用，严禁写成 NEXT_PUBLIC_）
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# 收款（当前通道：Dodo Payments，先跑测试模式）
# ============================================================
# 当前通道：dodo（默认）、paypal 或 stripe。切换需同时配好对应通道的变量。
PAYMENT_PROVIDER=dodo

# Dodo Payments（服务端专用，密钥严禁 NEXT_PUBLIC_ 前缀）
# 在 Dashboard 的 Test Mode 下创建 API Key、一次性商品和 Webhook。
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
# 只允许 test_mode；设为 live_mode 会被代码直接拒绝，避免真实扣款。
DODO_PAYMENTS_ENVIRONMENT=test_mode

# PayPal（备用通道；内地主体可直接开通）
# 在 developer.paypal.com 创建 App 拿 Client ID 和 Secret。
# 沙箱用 sandbox 账号的凭证 + PAYPAL_MODE=sandbox；正式改 live 凭证 + PAYPAL_MODE=live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_SECRET=YOUR_PAYPAL_SECRET

# Stripe（可选备用通道；需香港/海外主体。保留是为了日后可切回）
# 测试环境用 sk_test_，正式用 sk_live_
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FULL_REPORT=price_xxx
STRIPE_TAX_ENABLED=false

# 手机号 OTP 在 Supabase 控制台 Authentication → Providers → Phone 中配置短信服务商。
# 本应用不接触短信密钥。初期只开邮箱，手机入口在 app/auth/page.tsx 用开关收起。

# Plausible 埋点（海外免费、无需 GDPR 弹窗）。注册后填域名，例如 ziwei-insight.com
# https://plausible.io/sites/new  免费额度 10k PV/月；未配置时静默跳过
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
